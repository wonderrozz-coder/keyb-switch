#!/usr/bin/env python3
"""keyb-switch entry point.

Relaunches itself inside the virtualenv shipped next to the code (so
python-evdev and its libxkbcommon are always importable), and works unchanged
when run from a plain git checkout with system packages installed.
"""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
VENV = os.path.join(ROOT, ".venv")

# sys.prefix is the venv root when running inside it; comparing interpreters
# would fail because the venv python is often a symlink to the system one.
if os.path.isdir(VENV) and os.path.realpath(sys.prefix) != os.path.realpath(VENV):
    python = os.path.join(VENV, "bin", "python")
    if os.path.exists(python):
        os.execv(python, [python, os.path.abspath(__file__)] + sys.argv[1:])

if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from kbswitch.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
